# Copy to .env before starting the stack:
#   cp .env.example .env
# Generate long random values with: openssl rand -hex 32

# Frappe site and database bootstrap credentials.
# These are used only on first initialization of the persistent Frappe volume.
FRAPPE_SITE_NAME=hrms.localhost
MARIADB_ROOT_PASSWORD=replace-with-a-long-random-password
FRAPPE_ADMIN_PASSWORD=replace-with-a-long-random-password

# Create an API key and secret for a Frappe user with least-privilege HRMS access.
FRAPPE_API_KEY=replace-with-frappe-api-key
FRAPPE_API_SECRET=replace-with-frappe-api-secret
FRAPPE_REQUEST_TIMEOUT=30

# Protects the MCP gateway. The same value is passed to the HR agent.
MCP_BEARER_TOKEN=replace-with-a-long-random-token

# Protects the HR agent API. Keep this server-side; do not use a VITE_* name.
# The UI Nginx/Vite proxy injects it into requests to the agent.
AGENT_API_KEY=replace-with-a-long-random-token

# Temporary UI login. Change UI_PASSWORD before deployment.
UI_USERNAME=admin
UI_PASSWORD=replace-with-a-strong-password
UI_AUTH_SECRET=replace-with-another-long-random-token
AUTH_COOKIE_SECURE=false

# OpenAI-compatible model provider.
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=replace-with-provider-api-key
# Optional for Mistral, Ollama, OpenRouter, vLLM, etc.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Agent policy and application settings.
HITL_ENABLED=true
BYPASS_TOOL_CONSENT=false
LOW_LEAVE_THRESHOLD_DAYS=2.0
LOW_LEAVE_THRESHOLD_RATIO=0.15
APP_ENV=production
LOG_LEVEL=INFO

# Host ports. Keep backend ports on a private network or bind them to localhost
# when a separate reverse proxy is used.
UI_PORT=8080
AGENT_PORT=8001
MCP_PORT=8800
FRAPPE_PORT=8000

# Leave empty for the UI's same-origin Nginx proxy. Set an absolute URL only
# when the API is served from another origin and CORS is configured accordingly.
VITE_API_BASE_URL=
VITE_MODEL_NAME=hr-agent
