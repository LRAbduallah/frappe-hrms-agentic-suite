# ==============================================================================
# HR Operations Agent - Environment Configuration
# ==============================================================================

# 1. LLM Provider Configuration (OpenAI or any OpenAI-Compatible API)
# Works with OpenAI, Mistral, Ollama, LM Studio, vLLM, OpenRouter, Groq, Together, etc.
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=your_api_key_here
# Optional Base URL: leave blank for api.openai.com, or set for custom/local provider
# Examples:
#   Ollama:     http://localhost:11434/v1
#   LM Studio:  http://localhost:1234/v1
#   vLLM:       http://localhost:8000/v1
#   OpenRouter: https://openrouter.ai/api/v1
#   Groq:       https://api.groq.com/openai/v1
# OPENAI_BASE_URL=http://localhost:11434/v1

# 2. Frappe MCP Server Configuration
# Inside docker compose: http://mcp-gateway:8800/mcp
# Outside docker (local): http://localhost:8800/mcp or http://localhost:8000/mcp
FRAPPE_MCP_URL=http://mcp-gateway:8800/mcp
# Optional Bearer Token if MCP Gateway or Nginx reverse proxy requires authentication
FRAPPE_MCP_BEARER_TOKEN=your_mcp_bearer_token_here

# 3. HR Operations Thresholds
LOW_LEAVE_THRESHOLD_DAYS=2.0
LOW_LEAVE_THRESHOLD_RATIO=0.15

# 4. Governance & Human-In-The-Loop Approval
HITL_ENABLED=true
BYPASS_TOOL_CONSENT=false

# 5. Application & Session Settings
APP_ENV=development
LOG_LEVEL=INFO
SESSION_STORAGE_PATH=.sessions
APPROVALS_STORAGE_PATH=.approvals
